    <!-- TIMELINE TÓM TẮT -->
    <section class="overview-section">
        <p class="small-heading">TOÀN CẢNH LỘ TRÌNH</p>
        <h2>Các giai đoạn chính</h2>

        <div class="overview-timeline">
            <article>
                <span>01</span>
                <h3>Nhập học</h3>
                <p>Hoàn thiện thủ tục và ổn định tổ chức.</p>
            </article>

            <div class="timeline-arrow" aria-hidden="true">→</div>

            <article>
                <span>02</span>
                <h3>Huấn luyện</h3>
                <p>Rèn luyện tập trung tại trung tâm.</p>
            </article>

            <div class="timeline-arrow" aria-hidden="true">→</div>

            <article>
                <span>03</span>
                <h3>Nền tảng</h3>
                <p>Học kiến thức đại cương và cơ sở ngành.</p>
            </article>

            <div class="timeline-arrow" aria-hidden="true">→</div>

            <article>
                <span>04</span>
                <h3>Chuyên ngành</h3>
                <p>Học sâu theo lĩnh vực đào tạo.</p>
            </article>

            <div class="timeline-arrow" aria-hidden="true">→</div>

            <article>
                <span>05</span>
                <h3>Tốt nghiệp</h3>
                <p>Thực tập và hoàn thành chương trình.</p>
            </article>
        </div>
    </section>

    <!-- GIAI ĐOẠN 1 -->
    <section class="stage-section" id="nhap-hoc">
        <div class="stage-heading">
            <span class="stage-number">01</span>

            <div>
                <p>ỔN ĐỊNH – THÍCH NGHI – CHUẨN BỊ</p>
                <h2>Nhập học và ổn định tổ chức</h2>
            </div>
        </div>

        <div class="stage-content two-column">
            <article class="information-card">
                <h3>Thời gian dự kiến</h3>

                <p>
                    Theo lộ trình được mô tả, giai đoạn ban đầu có thể
                    kéo dài khoảng hai tuần trước khi học viên tham gia
                    huấn luyện đầu khóa.
                </p>

                <p class="card-note">
                    Thời gian thực tế được thực hiện theo kế hoạch
                    của từng nhà trường.
                </p>
            </article>

            <article class="information-card">
                <h3>Nội dung chính</h3>

                <ul>
                    <li>Hoàn thiện hồ sơ và thủ tục nhập học.</li>
                    <li>Phúc tra sức khỏe theo kế hoạch.</li>
                    <li>Nhận phòng và quân tư trang.</li>
                    <li>Làm quen với môi trường tập thể.</li>
                    <li>Học cách sắp xếp trật tự nội vụ.</li>
                    <li>Chuẩn bị tham gia huấn luyện đầu khóa.</li>
                </ul>
            </article>
        </div>
    </section>

    <!-- GIAI ĐOẠN 2 -->
    <section class="stage-section" id="huan-luyen">
        <div class="stage-heading">
            <span class="stage-number">02</span>

            <div>
                <p>KỶ LUẬT – THỂ LỰC – TÁC PHONG</p>
                <h2>Huấn luyện đầu khóa</h2>
            </div>
        </div>

        <div class="training-summary">
            <div>
                <p class="duration-label">THỜI GIAN THAM KHẢO</p>
                <strong>Khoảng 4–5 tháng</strong>
            </div>

            <p>
                Học viên học tập, sinh hoạt và rèn luyện tập trung
                tại Trung tâm Huấn luyện và Bồi dưỡng nghiệp vụ.
                Thời gian có thể thay đổi theo kế hoạch của từng khóa.
            </p>
        </div>

        <div class="subject-grid">
            <article>
                <span>01</span>
                <h3>Giáo dục chính trị</h3>
                <p>Bồi dưỡng nhận thức, trách nhiệm và bản lĩnh.</p>
            </article>

            <article>
                <span>02</span>
                <h3>Điều lệnh</h3>
                <p>Rèn tư thế, tác phong và ý thức chấp hành.</p>
            </article>

            <article>
                <span>03</span>
                <h3>Võ thuật</h3>
                <p>Rèn sức khỏe và các nội dung theo chương trình.</p>
            </article>

            <article>
                <span>04</span>
                <h3>Bơi</h3>
                <p>Học kỹ thuật bơi và được đánh giá bằng điểm.</p>
            </article>

            <article>
                <span>05</span>
                <h3>Thể lực</h3>
                <p>Hoàn thành các nội dung kiểm tra cuối khóa.</p>
            </article>

            <article>
                <span>06</span>
                <h3>Nội dung khác</h3>
                <p>
                    Học tập, huấn luyện theo chương trình
                    và yêu cầu của đơn vị.
                </p>
            </article>
        </div>

        <!-- PHÂN BIỆT BƠI VÀ THỂ LỰC -->
        <div class="fitness-box">
            <p class="small-heading">PHÂN BIỆT NỘI DUNG ĐÁNH GIÁ</p>
            <h3>Bơi và bốn nội dung rèn luyện thể lực</h3>

            <div class="fitness-columns">
                <article class="swimming-card">
                    <span class="fitness-icon" aria-hidden="true">01</span>

                    <h4>Môn bơi</h4>

                    <p>
                        Bơi là một học phần được đánh giá và tính điểm riêng
                        theo yêu cầu của chương trình.
                    </p>
                </article>

                <article class="required-fitness-card">
                    <span class="fitness-icon" aria-hidden="true">04</span>

                    <h4>Bốn nội dung thể lực bắt buộc</h4>

                    <p>
                        Học viên kiểm tra bốn nội dung vào cuối khóa
                        huấn luyện và phải hoàn thành đầy đủ cả bốn.
                    </p>
                </article>
            </div>

            <div class="fitness-tests">
                <article>
                    <strong>100 m</strong>
                    <span>Chạy cự ly ngắn</span>
                </article>

                <article>
                    <strong>1.500 m</strong>
                    <span>Chạy bền</span>
                </article>

                <article>
                    <strong>Kéo xà</strong>
                    <span>Sức mạnh thân trên</span>
                </article>

                <article>
                    <strong>Bật xa</strong>
                    <span>Sức mạnh và khả năng bật</span>
                </article>
            </div>

            <div class="completion-rule">
                <strong>Điều kiện hoàn thành:</strong>
                Học viên hoàn thành đủ cả bốn nội dung kiểm tra thể lực
                theo yêu cầu được áp dụng cho khóa huấn luyện.
            </div>

            <p class="fitness-warning">
                Tiêu chuẩn cụ thể của từng nội dung được thực hiện theo
                quy định áp dụng cho từng đối tượng và từng khóa học.
            </p>
        </div>

        <div class="detail-link">
            <a href="tan-hoc-vien#huan-luyen"
               data-enhance-nav="false">
                Xem chi tiết nội dung chuẩn bị huấn luyện đầu khóa →
            </a>
        </div>
    </section>

    <!-- NĂM 1 VÀ NĂM 2 -->
    <section class="stage-section" id="nam-mot-hai">
        <div class="stage-heading">
            <span class="stage-number">03</span>

            <div>
                <p>XÂY DỰNG KIẾN THỨC NỀN TẢNG</p>
                <h2>Năm thứ nhất và năm thứ hai</h2>
            </div>
        </div>

        <div class="year-grid">
            <article class="year-card">
                <p class="year-label">NĂM THỨ NHẤT</p>
                <h3>Làm quen chương trình chính khóa</h3>

                <ul>
                    <li>Các môn lý luận chính trị.</li>
                    <li>Khoa học xã hội và nhân văn.</li>
                    <li>Kiến thức pháp luật cơ bản.</li>
                    <li>Tin học, ngoại ngữ hoặc môn nền tảng.</li>
                    <li>Giáo dục thể chất và rèn luyện tác phong.</li>
                    <li>Phương pháp học tập ở bậc đại học.</li>
                </ul>
            </article>

            <article class="year-card">
                <p class="year-label">NĂM THỨ HAI</p>
                <h3>Củng cố nền tảng và cơ sở ngành</h3>

                <ul>
                    <li>Tiếp tục hoàn thành các môn đại cương.</li>
                    <li>Tiếp cận các môn cơ sở ngành.</li>
                    <li>Củng cố kiến thức pháp luật và nghiệp vụ.</li>
                    <li>Tiếp tục giáo dục thể chất.</li>
                    <li>Tham gia bơi, chạy hoặc hoạt động thể thao.</li>
                    <li>Rèn kỹ năng tập thể và khả năng tự học.</li>
                </ul>
            </article>
        </div>

        <div class="stage-message">
            Năm thứ nhất và năm thứ hai là giai đoạn xây dựng nền tảng
            kiến thức, thể lực, kỷ luật và phương pháp học tập.
        </div>
    </section>

    <!-- NĂM 3 -->
    <section class="stage-section" id="nam-ba">
        <div class="stage-heading">
            <span class="stage-number">04</span>

            <div>
                <p>ĐỊNH HƯỚNG – CHUYÊN SÂU – THỰC HÀNH</p>
                <h2>Năm thứ ba và giai đoạn chuyên ngành</h2>
            </div>
        </div>

        <p class="section-description">
            Học viên tiếp cận sâu hơn với kiến thức chuyên ngành.
            Đây là nền tảng quan trọng cho định hướng công tác sau khi tốt nghiệp.
        </p>

        <div class="specialization-grid">
            <article>
                <span>NGHIỆP VỤ</span>
                <h3>Nhóm ngành nghiệp vụ</h3>

                <ul>
                    <li>Học kiến thức nghiệp vụ chuyên sâu.</li>
                    <li>Phân tích và xử lý tình huống.</li>
                    <li>Kết hợp lý thuyết với thực hành.</li>
                    <li>Rèn kỹ năng phù hợp với ngành đào tạo.</li>
                </ul>
            </article>

            <article>
                <span>CÔNG NGHỆ</span>
                <h3>Công nghệ và an ninh mạng</h3>

                <ul>
                    <li>Công nghệ thông tin.</li>
                    <li>Mạng máy tính.</li>
                    <li>An toàn và an ninh thông tin.</li>
                    <li>Lập trình và hệ thống máy tính.</li>
                    <li>Toán học và tư duy logic.</li>
                </ul>
            </article>
        </div>

        <div class="notice-light">
            Chuyên ngành tạo nền tảng cho định hướng công tác,
            nhưng việc phân công nhiệm vụ còn phụ thuộc yêu cầu tổ chức
            và quyết định của cơ quan có thẩm quyền.
        </div>
    </section>

    <!-- NĂM CUỐI -->
    <section class="stage-section" id="nam-cuoi">
        <div class="stage-heading">
            <span class="stage-number">05</span>

            <div>
                <p>THỰC TẬP – HOÀN THIỆN – TỐT NGHIỆP</p>
                <h2>Năm cuối của chương trình</h2>
            </div>
        </div>

        <div class="final-year-grid">
            <article>
                <span>01</span>
                <h3>Thực tập</h3>

                <p>
                    Nhà trường phối hợp với các cơ quan, đơn vị để bố trí
                    địa điểm thực tập phù hợp với ngành đào tạo.
                </p>

                <ul>
                    <li>Chấp hành sự phân công.</li>
                    <li>Tuân thủ kỷ luật và bảo mật.</li>
                    <li>Vận dụng kiến thức đã học.</li>
                    <li>Hoàn thành báo cáo thực tập.</li>
                </ul>
            </article>

            <article>
                <span>02</span>
                <h3>Hoàn thành học phần</h3>

                <p>
                    Sau thực tập, học viên hoàn thiện các môn học,
                    báo cáo và điều kiện còn lại của chương trình.
                </p>

                <ul>
                    <li>Hoàn thành học phần còn thiếu.</li>
                    <li>Bổ sung điều kiện học tập và rèn luyện.</li>
                    <li>Chuẩn bị nhiệm vụ tốt nghiệp.</li>
                </ul>
            </article>

            <article>
                <span>03</span>
                <h3>Kết thúc khóa học</h3>

                <p>
                    Tùy chương trình, học viên có thể thực hiện một
                    trong các hình thức kết thúc khóa học.
                </p>

                <ul>
                    <li>Thi tốt nghiệp.</li>
                    <li>Bảo vệ khóa luận tốt nghiệp.</li>
                    <li>Bảo vệ đồ án đối với một số ngành kỹ thuật.</li>
                </ul>
            </article>
        </div>

        <div class="duration-note">
            <h3>Thời gian đào tạo</h3>

            <p>
                Thời gian đào tạo không hoàn toàn giống nhau giữa các ngành.
                Một số chương trình kỹ thuật, công nghệ hoặc an toàn thông tin
                có thể có thời lượng và số lượng học phần lớn hơn.
            </p>
        </div>
    </section>

    <!-- KẾT LUẬN -->
    <section class="summary-section">
        <p>HÀNH TRÌNH HỌC TẬP</p>

        <h2>
            Xây nền tảng vững – Học chuyên ngành sâu<br />
            Gắn lý luận với thực tiễn – Sẵn sàng nhận nhiệm vụ
        </h2>
    </section>

