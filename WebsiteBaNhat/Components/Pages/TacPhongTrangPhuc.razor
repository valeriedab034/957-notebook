    <!-- ====================================================== -->
    <!-- PHẦN III: YÊU CẦU CHUNG                             -->
    <!-- ====================================================== -->

    <section class="general-rules">
        <div class="season-heading">
            <span class="large-number">03</span>

            <div>
                <p class="eyebrow">CHỈNH TỀ – NGHIÊM TÚC – THỐNG NHẤT</p>
                <h2>Yêu cầu chung đối với nam và nữ</h2>
            </div>
        </div>

        <div class="rule-grid">
            <article class="rule-item">
                <span>01</span>
                <h3>Đúng quân phục</h3>
                <p>
                    Mặc đúng mẫu, đúng mùa và đúng hoàn cảnh;
                    không tự ý kết hợp các loại quân phục khác nhau.
                </p>
            </article>

            <article class="rule-item">
                <span>02</span>
                <h3>Đầy đủ dấu hiệu</h3>
                <p>
                    Cấp hiệu, phù hiệu và biển tên phải đầy đủ,
                    cân đối, đúng chiều và đúng vị trí.
                </p>
            </article>

            <article class="rule-item">
                <span>03</span>
                <h3>Áo quần phẳng</h3>
                <p>
                    Quân phục phải sạch sẽ, phẳng phiu;
                    cúc áo được cài đầy đủ theo đúng mẫu.
                </p>
            </article>

            <article class="rule-item">
                <span>04</span>
                <h3>Cổ áo và cà vạt</h3>
                <p>
                    Cổ áo không được lệch hoặc gập;
                    cà vạt phải nằm chính giữa hàng cúc.
                </p>
            </article>

            <article class="rule-item">
                <span>05</span>
                <h3>Không tự ý sửa đổi</h3>
                <p>
                    Không xắn tay áo, sửa kiểu dáng,
                    thay đổi màu sắc hoặc gắn phụ kiện không phù hợp.
                </p>
            </article>

            <article class="rule-item">
                <span>06</span>
                <h3>Tác phong nghiêm túc</h3>
                <p>
                    Đầu tóc, khuôn mặt, giày, tất và tư thế phải gọn gàng,
                    phù hợp với môi trường Công an nhân dân.
                </p>
            </article>
        </div>
    </section>

    <!-- PHẦN TÁC PHONG CAND -->
